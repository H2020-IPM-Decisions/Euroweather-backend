import os
import logging
import shutil
import subprocess
import sys
from datetime import timedelta
from poller_and_downloader import Poller, Downloader
from config_and_logger import init_logging, init_config
from forecaster import forecaster, forecast_archiver
from day_archiver import date_from_reftime

logger = logging.getLogger(__name__)
init_logging(logger)
CONFIG = init_config()
base_path = CONFIG.get("base_path")
ALL_PATH = CONFIG.get("all_path")
ARCHIVE_PATH = CONFIG.get("archive_path")
logger.debug(f"\nAll path is: {ALL_PATH}\nArchive path is: {ARCHIVE_PATH}")


def forecast_archives_are_current(all_file, reftime):
    source_mtime = os.path.getmtime(all_file)
    date_today = date_from_reftime(reftime)
    expected_paths = [
        os.path.join(
            ARCHIVE_PATH,
            f"daily_archive_{(date_today + timedelta(days=offset)).strftime('%Y%m%d')}.nc",
        )
        for offset in (1, 2)
    ]
    expected_paths.extend(
        os.path.join(
            ARCHIVE_PATH,
            f"daily_accumulated_{(date_today + timedelta(days=offset)).strftime('%Y%m%d')}.nc",
        )
        for offset in (1, 2)
    )
    expected_paths.append(
        os.path.join(
            ARCHIVE_PATH,
            f"{date_today.strftime('%Y')}_with_forecast.nc",
        )
    )

    current_archive_path = os.path.join(
        ARCHIVE_PATH,
        f"daily_archive_{date_today.strftime('%Y%m%d')}.nc",
    )
    if os.path.isfile(current_archive_path):
        expected_paths.extend(
            [
                current_archive_path,
                os.path.join(
                    ARCHIVE_PATH,
                    f"daily_accumulated_{date_today.strftime('%Y%m%d')}.nc",
                ),
            ]
        )

    return all(
        os.path.isfile(path) and os.path.getmtime(path) >= source_mtime
        for path in expected_paths
    )


grib_dir = os.path.join(ALL_PATH, "grib")
os.makedirs(grib_dir, exist_ok=True)
dwd_poller = Poller(
    "Anonymous",
    "",
    "",
    main_cycles=CONFIG.get("main_cycles"),
    base_ftp_link="/weather/nwp/v1/m/icon-eu/",
)
reftime, ready = dwd_poller.poll()
logger.info(f"Reftime was found to be {reftime} with status {ready}")
if ready:
    downloaded_files = []
    downloaded = False
    dwd_downloader = Downloader(dwd_poller, grib_dir)
    all_file = os.path.join(ALL_PATH, f"all{reftime}.nc")
    if not os.path.isfile(all_file):
        downloaded_files, downloaded = dwd_downloader.download_and_unzip(reftime)

    if downloaded:
        forecast_file = os.path.join(ALL_PATH, f"forecast_{reftime}.grib2")
        temporary_file = os.path.join(ALL_PATH, f"all{reftime}_tmp.nc")
        logger.info("Catting forecast-gribs")
        with open(forecast_file, "wb") as combined_file:
            for downloaded_file in downloaded_files:
                with open(downloaded_file, "rb") as input_file:
                    shutil.copyfileobj(input_file, combined_file)

        logger.info("Converting from grib to netcdf")
        fimex_environment = os.environ.copy()
        udunits_path = os.path.join(
            sys.prefix, "share", "udunits", "udunits2.xml"
        )
        if os.path.isfile(udunits_path):
            fimex_environment.setdefault("UDUNITS2_XML_PATH", udunits_path)
        subprocess.run(
            [
                "fimex-2.4",
                "--input.file",
                forecast_file,
                "--input.config",
                os.path.join(base_path, "cdmGribReaderConfig.xml"),
                "--output.file",
                temporary_file,
            ],
            check=True,
            env=fimex_environment,
        )
        forecaster(temporary_file, all_file)
        os.remove(temporary_file)
        logger.info(f"Readied the forecast at {all_file}")
        forecast_archiver(all_file, reftime)

    elif (
        os.path.isfile(all_file)
        and not forecast_archives_are_current(all_file, reftime)
    ):
        logger.info(
            "Forecast data was already converted, but its archives are incomplete; "
            "retrying archive generation"
        )
        forecast_archiver(all_file, reftime)

    elif os.path.isfile(all_file):
        logger.info("Forecast data and archives were already ready")

    else:
        raise FileNotFoundError(
            f"Forecast {reftime} is ready, but {all_file} was not created"
        )
